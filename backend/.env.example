# Copy to backend/.env and fill in. The .env file is gitignored — never commit it.

# OpenRouter key for the agent's LLM calls (intent parsing + synthesis)
OPENROUTER_API_KEY=

# LLM model used by the agent
OPENROUTER_MODEL=google/gemini-2.5-flash

# Audit store. SQLite needs no setup; for Postgres use e.g.
# postgresql+psycopg://user:pass@localhost:5432/argus
# DATABASE_URL=sqlite:///argus.db

# Dataset path overrides (defaults to dynamic download via kagglehub if not specified)
# DATA_PATH_OVERRIDE=
# ACCOUNTS_PATH_OVERRIDE=

# Fraction of clean accounts whose full histories are kept in the analysis
# sample (laundering-involved accounts are always kept in full). Default 0.25.
# SAMPLE_ACCOUNT_FRACTION=0.25